# Copy this file to .env and fill in your key. Never commit .env.
#
# BoardGameGeek API key (BGG calls it a token):
# 1. Register an application at https://boardgamegeek.com/applications
# 2. Once BGG approves it, create a token for the application and paste it below
BGG_API_KEY=

# User and group IDs; set to match your host user so mounted volumes are owned correctly
PUID=1000
PGID=1000
